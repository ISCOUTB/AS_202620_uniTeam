# Plantilla de variables de entorno de UniTeam.
#
# Copia este archivo a `.env` (que está en .gitignore y NUNCA se versiona) y
# ajusta los valores. `docker compose up` lo lee automáticamente; si no
# existe, usa los valores de desarrollo que declara compose.yaml.
#
# En el despliegue estas variables no salen de ningún archivo: se guardan en
# la configuración de Render (render.yaml las declara con `sync: false`).
# Guía completa: docs/despliegue/guia.md

# --- Base de datos local (compose.yaml) ------------------------------------
MYSQL_ROOT_PASSWORD=cambia-esto
MYSQL_DATABASE=uniteam
MYSQL_USER=uniteam
MYSQL_PASSWORD=cambia-esto

# --- API ------------------------------------------------------------------
# Sin DATABASE_URL, la API arranca sobre un SQLite local (solo desarrollo).
# DATABASE_URL=mysql+pymysql://uniteam:cambia-esto@127.0.0.1:3306/uniteam
# En producción (Aiven), con el certificado de la CA como Secret File:
# DATABASE_URL=mysql+pymysql://avnadmin:CLAVE@HOST:PUERTO/defaultdb?ssl_ca=/etc/secrets/aiven-ca.pem

OIDC_EMISOR=http://localhost:9000
OIDC_AUDIENCIA=uniteam-web
# OIDC_JWKS_URL=           # si la API alcanza al emisor por otra URL
OIDC_CLAIM_USUARIO=email
ORIGENES_PERMITIDOS=http://localhost:3000
ENTORNO=desarrollo
NIVEL_LOG=INFO

# --- Aplicación Web (se hornean al compilar; no son secretas) --------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OIDC_EMISOR=http://localhost:9000
NEXT_PUBLIC_OIDC_CLIENTE=uniteam-web
NEXT_PUBLIC_OIDC_AUDIENCIA=
NEXT_PUBLIC_OIDC_CLAIM_USUARIO=email
