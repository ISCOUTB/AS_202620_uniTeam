# Variables para docker-compose.yml y Dokploy.
# Copia a .env solo para pruebas locales. Nunca pongas valores reales en Git.

# Puertos internos; Traefik/Dokploy publica los servicios mediante dominios.
API_PORT=8000
WEB_PORT=3000
DB_PORT=3306

# MySQL incluido en docker-compose.yml.
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT
MYSQL_DATABASE=uniteam
MYSQL_USER=uniteam
MYSQL_PASSWORD=CAMBIA_ESTA_CLAVE

# Conexión usada por la API. En Dokploy, usa el hostname interno de tu BD.
DATABASE_URL=mysql+pymysql://uniteam:CAMBIA_ESTA_CLAVE@db:3306/uniteam

# API: valores del proveedor OpenID Connect real.
ENTORNO=produccion
NIVEL_LOG=INFO
CREAR_ESQUEMA=0
OIDC_EMISOR=https://TU_TENANT_OIDC/
OIDC_AUDIENCIA=TU_AUDIENCIA
# OIDC_JWKS_URL=https://TU_TENANT_OIDC/.well-known/jwks.json
OIDC_CLAIM_USUARIO=email
ORIGENES_PERMITIDOS=https://TU_DOMINIO_WEB

# Frontend: se hornean durante `npm run build` como build args.
NEXT_PUBLIC_API_URL=https://TU_DOMINIO_API
NEXT_PUBLIC_OIDC_EMISOR=https://TU_TENANT_OIDC
NEXT_PUBLIC_OIDC_CLIENTE=TU_CLIENT_ID_PUBLICO
NEXT_PUBLIC_OIDC_AUDIENCIA=TU_AUDIENCIA
NEXT_PUBLIC_OIDC_CLAIM_USUARIO=email

# Revisión opcional que aparecerá en /health.
REVISION=local
